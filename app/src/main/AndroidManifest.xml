<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name=".BenchmarkApplication" android:label="Retrec benchmark" android:icon="@drawable/ic_benchmark"
        android:theme="@style/BenchmarkTheme" android:allowBackup="false"
        android:usesCleartextTraffic="true" android:supportsRtl="true">
        <profileable android:shell="true" />
        <activity android:name=".BenchmarkActivity" android:exported="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        <activity android:name=".LauncherActivity" android:exported="true" android:process=":control"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:taskAffinity="${applicationId}.control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".ModeReceiver" android:exported="true" android:process=":control"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
